# Database KHUSUS Kopi Parang Keuangan. Jangan arahkan ke database Parang-ops.
# Jika satu server PostgreSQL dengan Parang-ops, pakai database DAN user database sendiri.
DATABASE_URL="postgresql://kpk_app:ganti-password@localhost:5432/kopiparang_keuangan?schema=public"
PORT=4100

# Rahasia penandatangan cookie sesi (min. 32 karakter acak). Beda dengan Parang-ops.
KPK_SESSION_SECRET="ganti-dengan-string-acak-panjang"
# Origin frontend yang boleh memanggil API (dipisah koma).
KPK_CORS_ORIGIN="http://localhost:5174"

# Dipakai prisma/seed.ts untuk membuat akun awal (hanya lingkungan dev/staging).
SEED_OWNER_EMAIL="owner@kopiparang.local"
SEED_OWNER_PASSWORD="ganti-password-owner"
SEED_KASIR_NAME="Kasir Demo"
SEED_KASIR_PIN="123456"
